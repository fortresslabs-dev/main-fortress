# =============================================================================
# Fortress — .env template  (COMMITTABLE — placeholders only, NO real secrets)
# =============================================================================
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored; `.env.example` is the shared, documented reference.
#
# TWO WAYS TO RUN
#   • LOCAL / OFFLINE : SECRETS_SOURCE=   (empty) → the app reads THIS file.
#   • AWS / PRODUCTION: SECRETS_SOURCE=aws        → config.py injects values
#       from SSM Parameter Store (/fortress/<CLIENT_NAME>/*) and Secrets
#       Manager; most values below are then ignored.
#
# The same image runs both ways — only SECRETS_SOURCE and the DB/Redis target
# change. Keep CLIENT_NAME=testbank (the only populated bank namespace).
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
PIPELINE_MODE=pipeline2            # pipeline1 (scraper/sync source) | pipeline2 (bank-side + dashboard)
ENVIRONMENT=development            # development | production
DEBUG=true                         # true enables verbose + SQLAlchemy echo (noisy); false for quiet
DEV_MODE=true                      # dev-token auth fallback; MUST be false in production
CLIENT_NAME=testbank               # SSM namespace slug; used as bank_id
AWS_REGION=us-east-1
AWS_PROFILE=fortress-local         # local only; the ~/.aws profile with Bedrock/SSM access

# Empty = read this file (local). "aws" = pull from SSM + Secrets Manager (prod).
SECRETS_SOURCE=

# ── DB / Redis ────────────────────────────────────────────────────────────────
# LOCAL (docker-compose pgvector:pg15 + redis). For the P2 dashboard use the P2
# database (synced reference data + seeded bank tables).
DATABASE_URL=postgresql+asyncpg://fortress:fortress_dev@localhost:5432/fortress_p2
REDIS_URL=redis://:fortress_dev@localhost:6379/0
# PRODUCTION (when SECRETS_SOURCE=aws these come from SSM/Secrets Manager; the
# entrypoint composes DATABASE_URL from the pieces below):
# AURORA_HOST=<cluster>.rds.amazonaws.com
# AURORA_PORT=5432
# DB_NAME=fortress_p2
# DB_USER=fortress_testbank
# DB_PASSWORD=<secret>
# REDIS_HOST=<elasticache-endpoint>
# REDIS_AUTH_TOKEN=<secret>

# ── Auth / dashboard ───────────────────────────────────────────────────────────
# LOCAL: SPA built with VITE_E2E_AUTH_BYPASS=1 sends `Bearer <PIPELINE2_API_TOKEN>`
# (default e2e-bypass) and the API accepts it because DEV_MODE=true. Leave the
# Cognito pool blank locally so no token can trigger the production JWT path.
PIPELINE2_API_TOKEN=e2e-bypass
COGNITO_USER_POOL_ID=              # PROD: us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=                 # PROD: xxxxxxxxxxxxxxxxxxxxxxxxxx
DASHBOARD_URL=                     # PROD CloudFront URL
# JSON array (pydantic-settings JSON-decodes List env vars — a comma string errors).
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Bedrock (LLM) ──────────────────────────────────────────────────────────────
# In containers, provide AWS creds (mount ~/.aws or pass AWS_ACCESS_KEY_ID/SECRET).
LLM_PROVIDER=bedrock
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
P1_OBLIGATION_EXTRACTION_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ── JIRA (enables "Create story" / generate-test) ────────────────────────────
JIRA_URL=https://<your-org>.atlassian.net
JIRA_USERNAME=<email>
JIRA_API_TOKEN=<atlassian-api-token>
JIRA_WEBHOOK_SECRET=<webhook-secret>
JIRA_PROJECT_KEY=MDP
# JIRA_ISSUE_TYPE=Task

# ── GitHub (6-agent pipeline opens the PR; skips cleanly if unset) ────────────
GITHUB_TOKEN=<github-pat>
GITHUB_ORG=<org>
GITHUB_REPO=<repo>

# ── P2 auth / sync secrets ────────────────────────────────────────────────────
PIPELINE2_API_KEY=<p2-api-token>
JWT_SECRET=<jwt-secret>
INTERNAL_SYNC_SECRET=<internal-sync-secret>

# ── P1→P2 sync source ──────────────────────────────────────────────────────────
PIPELINE1_API_URL=https://api.fortresslabs.dev        # LOCAL: http://host.docker.internal:8001
PIPELINE1_API_KEY=<p1-api-key>
# UpdateService reads these (entrypoint aliases PIPELINE1_API_KEY→FORTRESS_API_KEY,
# CLIENT_NAME→CUSTOMER_ID). For a LOCAL P1 on :8001:
# FORTRESS_API_URL=http://host.docker.internal:8001
# FORTRESS_API_KEY=<raw key registered in client_credentials for this customer>
# CUSTOMER_ID=testbank

# ── P1 (only if running the scraper/sync source locally) ──────────────────────
S3_BUCKET=
S3_CHUNK_PREFIX=scraper-chunks
