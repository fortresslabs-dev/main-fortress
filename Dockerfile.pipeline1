# ─────────────────────────────────────────────────────────────────
# PIPELINE 1 — Fortress Cloud
# Read-only compliance rules API + autonomous scraper agents.
# Deployed on Fortress-managed AWS infrastructure.
# ─────────────────────────────────────────────────────────────────
# Base image digest-pinned (B10). Refresh with:
#   docker buildx imagetools inspect python:3.11-slim
# and bump the digest below. Floating tags are rejected by the
# test_dockerfile_digest_pin_b10 verifier in CI.
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0

WORKDIR /app

# System deps:
#   build-essential + curl    — pip compilation, health check
#   tesseract-ocr             — OCR strategy in PdfExtractionAgent
#   poppler-utils             — pdf2image (pdfinfo/pdftoppm)
#   libmagic1                 — python-magic / unstructured file-type detection
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gfortran \
    curl \
    tesseract-ocr \
    poppler-utils \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-pipeline1.txt requirements.txt
RUN pip install --no-cache-dir --prefer-binary -r requirements.txt

COPY . .

# Create log dir and non-root user before dropping privileges
RUN mkdir -p /var/log/textmind \
    && addgroup --system fortress \
    && adduser --system --ingroup fortress --no-create-home fortress \
    && chown -R fortress:fortress /app /var/log/textmind

USER fortress

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["/bin/bash", "scripts/entrypoint.sh"]
