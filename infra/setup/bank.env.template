# ────────────────────────────────────────────────────────────────────────────
#  Fortress P2 — Bank credentials template
#  Copy to bank.env.<BANK_ID> (gitignored), fill in, then run:
#      ./scripts/load-bank-credentials.sh --env-file infra/setup/bank.env.testbank
#
#  Run AFTER `pipeline2-data.yml` deploys (secret shells exist),
#  BEFORE `pipeline2-compute.yml` deploys (ECS reads the values at boot).
# ────────────────────────────────────────────────────────────────────────────

# ── Identity ────────────────────────────────────────────────────────────────
BANK_ID=testbank
AWS_REGION=us-east-1
AWS_PROFILE=default

# ── JIRA (obtain at id.atlassian.com → Manage profile → Security → API tokens)
JIRA_URL=https://fortresscomp.atlassian.net
JIRA_USERNAME=compliance@yourbank.com
JIRA_API_TOKEN=ATATT3xFfGF0_REPLACE_ME
JIRA_PROJECT_KEY=COMP

# ── GitHub (fine-grained PAT, scope = bank repo only; Contents R/W + PRs R/W)
GITHUB_TOKEN=github_pat_REPLACE_ME
GITHUB_ORG=yourbank
GITHUB_REPO=core-banking-platform

# ── JWT signing secret (auto-generated by loader if left blank)
JWT_SECRET=
